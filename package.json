{
  "name": "opencards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic card-game engine, editor and simulator.",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "packages/core",
    "packages/schema",
    "packages/effects",
    "packages/simulator",
    "packages/app",
    "packages/ai",
    "games/ember-foundry",
    "games/quick-sparks"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "echo 'Phase 5 wires Vite dev server' && exit 0",
    "build:web": "node scripts/build-app-static.mjs",
    "art": "node scripts/generate-card-art.mjs",
    "build:app": "npm run build --workspace=@opencards/core && npm run build:web",
    "test": "npm run --workspaces --if-present test",
    "test:watch": "vitest",
    "verify:schema-runtime": "npm run build --workspace=@opencards/schema && node scripts/verify-schema-runtime.mjs",
    "verify:app": "npm run build:app && node scripts/verify-app-smoke.mjs",
    "verify:replay": "node scripts/verify-replay.mjs",
    "verify:hidden-info": "node scripts/verify-hidden-info.mjs",
    "verify:coverage-overall": "node scripts/check-overall-coverage.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run verify:coverage-overall && npm run verify:replay && npm run verify:hidden-info",
    "verify:mvp": "node scripts/verify-mvp.mjs",
    "prepare": "husky || true",
    "verify:balance": "node scripts/verify-foundry-balance.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.5",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^3.23.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.5"
  }
}
